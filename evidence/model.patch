+  $process=Get-Process -Name powershell -ErrorAction SilentlyContinue | Where-Object {$_.MainWindowTitle -eq 'SWE-REVIEW-surge-8ba94984'} | Select-Object -First 1
+ } while($null -eq $process -and [DateTime]::UtcNow -lt $deadline)
