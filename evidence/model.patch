+ [void][SurgeReviewCapture]::GetWindowThreadProcessId($overlayRoot,[ref]$overlayOwner)
+ Write-Output "Overlay: $overlayRoot $overlayClass $((Get-Process -Id $overlayOwner).ProcessName)"
+ if($overlayRoot -ne $h -and $overlayClass.ToString() -match 'Sogou|SoGou|SoPY_|IME|SG'){
+  [void][SurgeReviewCapture]::ShowWindow($overlayRoot,0)
+  $hiddenIme += $overlayRoot
+ }
+ Start-Sleep -Milliseconds 500
+ $r=New-Object SurgeReviewCapture+RECT
+ $p=New-Object SurgeReviewCapture+POINT
+ if(-not [SurgeReviewCapture]::GetClientRect($h,[ref]$r)){throw 'GetClientRect failed'}
+ if(-not [SurgeReviewCapture]::ClientToScreen($h,[ref]$p)){throw 'ClientToScreen failed'}
+ $w=$r.Right-$r.Left; $height=$r.Bottom-$r.Top
